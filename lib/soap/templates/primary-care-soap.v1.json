      "key": "subjective",
      "title": "Subjective",
      "fields": [
        {
          "key": "chiefComplaints",
          "label": "Chief complaints",
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "item": {
            "type": "textarea",
            "label": "Complaint"
          }
        },
        {
          "key": "historyOfPresentingIllness",
          "label": "History of presenting illness (HOPI)",
          "type": "textarea"
        },
        {
          "key": "pastMedicalHistory",
          "label": "Past medical history",
          "type": "group",
          "fields": [
            {
              "key": "hypertension",
              "label": "Hypertension",
              "type": "checkbox"
            },
            {
              "key": "diabetes",
              "label": "Diabetes",
              "type": "checkbox"
            },
            {
              "key": "tb",
              "label": "TB",
              "type": "checkbox"
            },
            {
              "key": "asthmaCopd",
              "label": "Asthma/COPD",
              "type": "checkbox"
            },
            {
              "key": "ihd",
              "label": "IHD",
              "type": "checkbox"
            },
            {
              "key": "stroke",
              "label": "Stroke",
              "type": "checkbox"
            },
            {
              "key": "ckd",
              "label": "CKD",
              "type": "checkbox"
